{
  "name": "auction-domain-aggregator-v4",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "node --import tsx scripts/test-d1-integration.ts",
    "benchmark:filters": "node --import tsx scripts/benchmark-domain-filters.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env-file /dev/null",
    "sync": "wrangler d1 migrations apply DB --local --config wrangler.ingestion.jsonc --env-file /dev/null && node --env-file-if-exists=../../.secrets/providers.env --import tsx scripts/sync-provider.ts",
    "sync:dynadot": "pnpm sync dynadot",
    "check:quick": "pnpm lint && pnpm typecheck && pnpm db:check && pnpm test",
    "check": "pnpm check:quick && pnpm test:integration && pnpm test:e2e",
    "deploy": "opennextjs-cloudflare build && node --import tsx scripts/assert-no-bundled-env.ts && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && node --import tsx scripts/assert-no-bundled-env.ts && opennextjs-cloudflare upload",
    "preview": "pnpm db:migrate:local && opennextjs-cloudflare build && node --import tsx scripts/assert-no-bundled-env.ts && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-file /dev/null --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@opennextjs/cloudflare": "^1.19.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.44.7",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.10",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
