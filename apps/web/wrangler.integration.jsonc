{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auction-domain-aggregator-integration-local",
  "main": "src/server/ingestion/integration-worker.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auction-domain-aggregator-integration-local",
      "database_id": "integration-only-do-not-deploy",
      "migrations_dir": "drizzle",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "FEED_PAGES",
      "bucket_name": "auction-domain-aggregator-integration-feed-pages-local",
      "remote": false
    }
  ]
}
