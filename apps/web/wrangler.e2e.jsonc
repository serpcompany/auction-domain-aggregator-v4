{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auction-domain-aggregator-e2e-local",
  "main": "worker.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_request_signal"],
  // Bundling with kept names injects __name() into functions that next-themes serializes into
  // its inline script, which then throws in the browser.
  "keep_names": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auction-domain-aggregator-e2e-local",
      "database_id": "e2e-only-do-not-deploy",
      "migrations_dir": "drizzle",
      "remote": false
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "auction-domain-aggregator-e2e-local"
    }
  ]
}
