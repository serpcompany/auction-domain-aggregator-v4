// Ingestion Worker: a daily Cron Trigger starts one `provider-sync` Workflow
// instance per provider (src/server/ingestion/sync-worker.ts). The top level
// is local-only: every binding stays in Wrangler's local simulation and the
// IDs are placeholders. `env.staging` and `env.production` are the deployed
// Workers; named environments inherit no bindings, so each declares every
// one, and every remote command passes `--env`. CI deploys staging from the
// `staging` branch and production from `main` (.github/workflows/ci.yml); see
// docs/technical-design/deployment.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auction-domain-aggregator-ingestion-local",
  "main": "src/server/ingestion/sync-worker.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Staging GoDaddy's archive measured about 3 to 8 seconds of CPU in local
  // workerd; each Workflow step gets this limit (Workers Paid allows up to
  // 300,000). Local workerd does not enforce it.
  "limits": {
    "cpu_ms": 60000
  },
  // GoDaddy publishes its daily file around 14:30 UTC.
  "triggers": {
    "crons": ["30 15 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auction-domain-aggregator-local",
      "database_id": "local-only-do-not-deploy",
      "migrations_dir": "drizzle",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "FEED_PAGES",
      "bucket_name": "auction-domain-aggregator-feed-pages-local",
      "remote": false
    }
  ],
  "workflows": [
    {
      "name": "provider-sync",
      "binding": "PROVIDER_SYNC",
      "class_name": "ProviderSyncWorkflow"
    }
  ],
  "env": {
    // Staging: the same Worker and Workflow on Staging's own D1 and R2, synced
    // daily at 23:30 UTC (08:30 in Japan), eight hours after Production.
    "staging": {
      "name": "auction-domain-aggregator-ingestion-staging",
      // No HTTP routes: no workers.dev URL and no preview URLs.
      "workers_dev": false,
      "preview_urls": false,
      "limits": {
        "cpu_ms": 60000
      },
      "triggers": {
        "crons": ["30 23 * * *"]
      },
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "auction-domain-aggregator-staging",
          "database_id": "3098593e-a81d-4e62-a4d7-f4cb9a750217",
          "migrations_dir": "drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      // The same 2-day `expire-staged-feed-pages` lifecycle rule as production.
      "r2_buckets": [
        {
          "binding": "FEED_PAGES",
          "bucket_name": "auction-domain-aggregator-feed-pages-staging"
        }
      ],
      "workflows": [
        {
          "name": "auction-domain-aggregator-provider-sync-staging",
          "binding": "PROVIDER_SYNC",
          "class_name": "ProviderSyncWorkflow"
        }
      ]
    },
    "production": {
      "name": "auction-domain-aggregator-ingestion-production",
      // No HTTP routes: no workers.dev URL and no preview URLs.
      "workers_dev": false,
      "preview_urls": false,
      "limits": {
        "cpu_ms": 60000
      },
      "triggers": {
        "crons": ["30 15 * * *"]
      },
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "auction-domain-aggregator-production",
          "database_id": "b6bbc65a-d376-4191-b9ae-a8f4290ac3dc",
          "migrations_dir": "drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      // A bucket lifecycle rule expires `feed-pages/` objects after 2 days, so
      // pages a failed cleanup step leaves behind cannot accumulate.
      "r2_buckets": [
        {
          "binding": "FEED_PAGES",
          "bucket_name": "auction-domain-aggregator-feed-pages-production"
        }
      ],
      // Workflow names are account-wide, so this one is prefixed.
      "workflows": [
        {
          "name": "auction-domain-aggregator-provider-sync-production",
          "binding": "PROVIDER_SYNC",
          "class_name": "ProviderSyncWorkflow"
        }
      ]
    }
  }
}
